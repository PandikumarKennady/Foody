# Contentstack Configuration
# Get these values from your Contentstack account dashboard

# Required: Basic Configuration
REACT_APP_CONTENTSTACK_API_KEY=your_api_key_here
REACT_APP_CONTENTSTACK_DELIVERY_TOKEN=your_delivery_token_here
REACT_APP_CONTENTSTACK_ENVIRONMENT=your_environment_name
E

# Optional: Branch Configuration (defaults to 'main' if not specified)
REACT_APP_CONTENTSTACK_BRANCH=main

# Optional: Region Configuration
# Options: us, eu, azure-na, azure-eu, gcp-na
# Leave empty or set to 'us' for US region
REACT_APP_CONTENTSTACK_REGION=us

# Optional: Custom API Host
# Only set this if you're using a custom host URL
REACT_APP_CONTENTSTACK_API_HOST=

# Optional: Live Preview Configuration
# Set to 'true' to enable live preview feature
REACT_APP_CONTENTSTACK_LIVE_PREVIEW=false

# Required if Live Preview is enabled
REACT_APP_CONTENTSTACK_PREVIEW_TOKEN=your_preview_token_here
REACT_APP_CONTENTSTACK_PREVIEW_HOST=your_preview_host_here
REACT_APP_CONTENTSTACK_APP_HOST=your_app_host_here
REACT_APP_CUSTOMER_EMAIL_TRIGGER_AUTOMATE_URL='https://app.contentstack.com/automations-api/run/8dd7b2c0f8a84565a849102afdfae5ab'
